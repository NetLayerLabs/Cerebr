# All optional. The Cerebr CPU normally comes from src/generated/cpus.ts (npm run sync, from launch/out).
# VITE_DEFAULT_CHAIN_ID=196          # chain shown before a wallet connects (196 | 31337 = local X Layer fork)
# VITE_RPC_196=https://rpc.xlayer.tech
# VITE_RPC_31337=http://127.0.0.1:8545
# VITE_ENABLE_ANVIL=true             # offer the local fork + dev account in a production build (always on in `npm run dev`)
# VITE_CPU_196=0x...                 # override the Cerebr CPU (its circuits address) per chain
# VITE_SCOPE_196=0x...               # CerebrScope address per chain (on-chain die shots + metadata)
# VITE_ANVIL_AUTOCONNECT=true        # local demos: auto-connect anvil's unlocked dev account #2 (no key held)
