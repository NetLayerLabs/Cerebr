# All optional. The app runs on X Layer mainnet (196) only, with real injected wallets (OKX Wallet first).
# The Cerebr CPU normally comes from src/generated/cpus.ts (npm run sync, from launch/out).
# VITE_RPC_196=https://rpc.xlayer.tech   # private X Layer RPC
# VITE_CPU_196=0x...                     # override the Cerebr CPU (its circuits address), build time
# VITE_SCOPE_196=0x...                   # override CerebrScope (onchain die shots, metadata and circuit labels)
# VITE_DROPS_196=0x...                   # override the drops contract (Genesis Drop), see src/config/contracts.ts
# VITE_MARKET_196=0x...                  # override the circuit marketplace
# VITE_ARENA_196=0x...                   # override NeuralArena
#
# Scripts only (Node, never in the browser bundle):
# FORK_RPC=http://127.0.0.1:8564         # npm run smoke: a LOCAL anvil fork of X Layer (loopback only)
# CHAIN_ID=31337                         # npm run smoke: the fork's --chain-id
# CPU=0x...                              # npm run smoke: reuse an existing CPU on the fork
