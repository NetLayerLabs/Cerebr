# All optional. Addresses normally come from src/generated/deployments.ts (npm run sync).
# VITE_DEFAULT_CHAIN_ID=196          # chain shown before a wallet connects (196 | 1952 | 31337)
# VITE_RPC_196=https://rpc.xlayer.tech
# VITE_RPC_1952=https://testrpc.xlayer.tech
# VITE_RPC_31337=http://127.0.0.1:8545
# VITE_ENABLE_ANVIL=true             # offer local anvil + dev account in a production build (always on in `npm run dev`)
# VITE_LENS_196=0x...                # override the CerebrLens address per chain; everything else is read from it
# VITE_LENS_1952=0x...
# VITE_ANVIL_AUTOCONNECT=true        # local demos: auto-connect anvil's unlocked account #0 (no key held)
