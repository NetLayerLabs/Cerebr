# Cerebr Agent keeper configuration. Copy to .env (Docker) or /etc/cerebr-agent.env (systemd), chmod 600.
# Never commit the filled-in file.

# Required. "xlayer" = X Layer mainnet (real OKB; the RPC must report chainId 196 and not be a dev node).
#           "fork"   = a local anvil fork (the RPC must be anvil/hardhat).
NETWORK=xlayer
RPC_URL=https://rpc.xlayer.tech

# Required. The deployed CerebrAgent (script/DeployAgent.s.sol prints it).
AGENT_ADDRESS=

# Required unless DRY_RUN=1. A DEDICATED hot wallet that holds only gas money (~0.01-0.02 OKB).
# Alternatively AGENT_PRIVATE_KEY_FILE=/run/secrets/agent_key. The key is never logged.
AGENT_PRIVATE_KEY=

# 1 = observe and simulate act() every cycle, never send a transaction.
DRY_RUN=0

# Seconds between cycles. The contract rate-limits act() to one per minIntervalBlocks (300 blocks ~ 5 min).
# Measured cost at 0.02 gwei: ~0.00037 OKB/day at 600 s, ~0.00012 at 1800 s.
INTERVAL_SEC=600

# Refuse to start / stop sending below this balance.
MIN_BALANCE_OKB=0.001
# Skip a cycle if maxFeePerGas would exceed this (X Layer runs at ~0.02 gwei).
MAX_FEE_GWEI=1
MAX_PRIORITY_FEE_GWEI=0.001
# Gas limit = estimate * GAS_MARGIN_BPS / 10000. (act() needs >1.03M gas available for the eval budget;
# only the ~130-180k actually used is paid.)
GAS_MARGIN_BPS=12000
TX_TIMEOUT_SEC=120

# Optional: once per CHECKPOINT_INTERVAL_SEC, call act() THROUGH the policy circuit's TapeOut brain wallet
# (account.execute), so the decision is recorded as the neuron acting through its own wallet.
# Requires: the brain wallet is opened (0.08 OKB, one-time) AND the hot wallet owns the circuit NFT.
# Each checkpoint pays TapeOut's EXEC_FEE of 0.0013 OKB (= ~3.5 days of act() gas; daily checkpoints cost
# ~0.039 OKB/month, ~3.5x the act() gas itself). Default off.
BRAIN_WALLET_CHECKPOINT=0
CHECKPOINT_INTERVAL_SEC=86400

# Read-only status endpoint (GET /health, GET /status). Keep it on loopback.
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8787
STATE_FILE=./data/state.json
LOG_LEVEL=info
