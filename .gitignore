# Compiler files
/cache/
/out/

# Commonly ignored directories
.logs/
.ignore/

# Docs
docs/

# Dotenv file
.env
.env.*
!.env.example

# Per-agent / scratch build dirs and broadcasts
out-*/
cache-*/
broadcast/

# dApp build output and dependencies
app/node_modules/
app/dist/

# SDK dependencies
sdk/node_modules/

# Launch: mainnet records (launch/out/196.json, launch/state.196.json) ARE committed;
# fork rehearsal records, archived states and temp files are not.
launch/state.*.fork*.json
launch/out/*.fork.json
launch/*.stale-*.json
launch/**/*.tmp

# Demo film (video/): heavy, regenerable artefacts
video/node_modules/
video/out/
video/.cache/
video/public/footage/
video/public/stills/
